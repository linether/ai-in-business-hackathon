# Copy to .env and fill in. .env is gitignored — never commit real keys.

# One LLM key is enough. DEEPSEEK_API_KEY is checked first, then
# ANTHROPIC_API_KEY — see src/complaintguard/llm.py:default_client.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Public hostname Caddy issues the certificate for.
# e.g. complaintguard.duckdns.org
SITE_DOMAIN=

# The live room at /live. It spends transcription and speech credits on every
# turn and it is a public URL, so it has a manual switch: open it for judging and
# while testing, close it otherwise. Closing it never affects /try or the twelve
# prepared cases. Flip it with scripts/room.sh.
LIVE_ROOM=on

# Audio in the live room, switchable on its own. Speech is the expensive half —
# if credits run low, turn this off first and the room keeps working as text.
LIVE_VOICE=on
