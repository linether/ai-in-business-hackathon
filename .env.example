# Copy to .env and fill in. .env is gitignored — never commit real keys.

# One LLM key is enough. DEEPSEEK_API_KEY is checked first, then
# ANTHROPIC_API_KEY — see src/complaintguard/llm.py:default_client.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Public hostname Caddy issues the certificate for.
# e.g. complaintguard.duckdns.org
SITE_DOMAIN=
